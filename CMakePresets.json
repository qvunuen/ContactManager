{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "System Dependencies",
      "description": "Build using already-installed system libraries (Homebrew, apt, etc.)",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "vcpkg-linux",
      "displayName": "vcpkg (Linux x64)",
      "description": "Install Boost.Test and Qt6 via vcpkg manifest (SQLite3 via system or FetchContent)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-linux"
      }
    },
    {
      "name": "vcpkg-windows",
      "displayName": "vcpkg (Windows x64)",
      "description": "Install Boost.Test and Qt6 via vcpkg manifest (SQLite3 via system or FetchContent)",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "DEPLOY_QT_RUNTIME": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default"
    },
    {
      "name": "vcpkg-linux",
      "configurePreset": "vcpkg-linux"
    },
    {
      "name": "vcpkg-windows",
      "configurePreset": "vcpkg-windows",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "vcpkg-linux",
      "configurePreset": "vcpkg-linux",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "vcpkg-windows",
      "configurePreset": "vcpkg-windows",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
